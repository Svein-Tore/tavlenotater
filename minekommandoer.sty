%--- lage en liste a,b,c---- eller 1,2,3
\newcommand{\liste}[2][a]{%
    \def\listestyle{\alph*)}% Standard er a)
    
    % En helt ren sjekk uten ekstrapakker som aldri lekker tekst på arket:
    \ifx#11\def\listestyle{\arabic*.}\fi%
    \ifx#1a\def\listestyle{\alph*)}\fi%
    \ifx#1A\def\listestyle{\Alph*)}\fi%
    \ifx#1*\def\listestyle{\textbullet}\fi% Sjekker stjernen helt trygt
    
    \begin{enumerate}[label=\listestyle]
        #2
    \end{enumerate}%
}
% --- Robust linjeskift ---
\newcommand{\nl}[1][1]{%
  \par
  \vspace*{#1\baselineskip}%
  \noindent
}
% --- Fontstørrelse kommando ---
% Bruk: \setfontsize{16pt}
\newcommand{\setfontsize}[1]{%
  \fontsize{#1}{1.2#1}\selectfont
}

