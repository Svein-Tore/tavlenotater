% --- TikZ: Stempel ---
\newcommand{\stempel}[1][4]{%
\begin{tikzpicture}
    \pgfmathsetmacro{\myLength}{#1}
    \draw (2,2)--(8,2)--(8,0)--(2,0)--(2,2);
    \draw (\myLength,0)--(\myLength+0.5,0)--(\myLength+0.5,2)--(\myLength,2)--(\myLength,0);
    \draw [line width=2pt] (\myLength,0)--(\myLength+0.5,0.5);
    \draw [line width=2pt] (\myLength,0.5)--(\myLength+0.5,1);
    \draw [line width=2pt] (\myLength,1)--(\myLength+0.5,1.5);
    \draw [line width=2pt] (\myLength,1.5)--(\myLength+0.5,2);
    \draw [line width=2pt] (\myLength,1)--(\myLength-2.5,1);
    % Stempel-mønster linjer
    \draw [line width=1pt] (\myLength-2,0.7)--(\myLength-1.8,1.3);
    \draw [line width=1pt] (\myLength-1.8,1.3)--(\myLength-1.6,0.7);
    \draw [line width=1pt] (\myLength-1.6,0.7)--(\myLength-1.4,1.3);
    \draw [line width=1pt] (\myLength-1.4,1.3)--(\myLength-1.2,0.7);
    \draw [line width=1pt] (\myLength-1.2,0.7)--(\myLength-1,1.3);
    \draw [line width=1pt] (\myLength-1,1.3)--(\myLength-0.8,0.7);
    \draw [line width=1pt] (\myLength-0.8,0.7)--(\myLength-0.6,1.3);
    \draw [line width=1pt] (\myLength-0.6,1.3)--(\myLength-0.4,0.7);
    \draw [line width=1pt] (\myLength-0.4,0.7)--(\myLength-0.2,1.3);
    \draw [line width=1pt] (\myLength-0.2,1.3)--(\myLength,0.7);
\end{tikzpicture}%
}

% --- TikZ: Mol-trekant ---
\NewDocumentCommand{\trekant}{O{m} O{n} O{Mm}}{%
\begin{center}
    \begin{tikzpicture}
        \draw (0,2.5)--(1.5,0);
        \draw (1.5,0)--(-1.5,0);
        \draw (-1.5,0)--(0,2.5);
        \draw (0,1.0)--(0,0);
        \draw (-0.9,1)--(0.9,1);
        \node at (0,1.5) {\LARGE #1};
        \node at (-0.6,0.4) {\LARGE #2};
        \node at (0.6,0.4) {\LARGE #3};
    \end{tikzpicture}    
\end{center}%
}

% --- TikZ: Varmeveksler ---
\newcommand{\varmeveksler}[6]{%
\begin{center}
    \begin{tikzpicture}
        \def\Tvinn{#1} \def\Tvut{#2} \def\Tkut{#3} \def\Tkinn{#4}
        \def\Fv{#5} \def\Fk{#6}
        \draw (2,2)--(8,2)--(8,-2)--(2,-2)--(2,2);
        \draw (2,2) arc[start angle=90,end angle=270,radius=2];
        \draw (8,-2) arc[start angle=270,end angle=450,radius=2];
        \foreach \x in {-2,-1.4,...,2} {\draw(2,\x)--(8,\x);}
        \draw[->, very thick](-2,0)--(0,0);
        \draw[->, very thick](10,0)--(12,0);
        \draw[->, ultra thick](7.5,4)--(7.5,2);
        \draw[->, ultra thick](2.5,-2)--(2.5,-4);
        \draw[ultra thick](7.2,2)--(7.2,-1);
        \draw[ultra thick](6,1)--(6,-2);
        \draw[ultra thick](4.5,2)--(4.5,-1);
        \draw[ultra thick](3,1)--(3,-2);
        \node at (-2,0.5) {$T_{v,inn}$=\Tvinn $^0C$};
        \node at (11.5,0.4) {$T_{v,ut}=$\Tvut $^0C$};
        \node at (9,3.5) {$T_{k,inn}=$\Tkinn $^0C$};
        \node at (3.7,-3) {$T_{k,ut}=$\Tkut $^0C$};
        \node at (-2.6,-0.5) {$F_v$=\Fv $kg/s$};
        \node at (8.8,2.8) {$F_k=$\Fk $kg/s$};
    \end{tikzpicture}
\end{center}%
}

% --- TikZ: FOPDT med dødtid ---
% Bruk: \plotfopdt{datafil}{A}{T}{L}{y0}
\newcommand{\plotfopdt}[5]{%
\begin{tikzpicture}
\begin{axis}[
    width=14cm,
    height=8cm,
    grid=both,
    xlabel={Tid $t$},
    ylabel={Nivå / respons},
    legend style={at={(0.97,0.03)}, anchor=south east},
    ymin=0, ymax=#2+10,xmax=400
]
\addplot[
    blue, only marks, mark=*, mark size=0.2pt, thick
] table[x=tid,y=niva,col sep=space] {#1};
\addlegendentry{Måledata}
\addplot[
    red, thick, samples=600, domain=0:315
]
{ (x<#4 ? #5 : #2 * (1 - exp(-(x-#4)/#3)) + #5) };
\addlegendentry{FOPDT: A=#2, T=#3, L=#4}
\end{axis}
\end{tikzpicture}%
}
